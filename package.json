{
  "name": "bothub",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/homalozoa/bothub.git"
  },
  "bugs": {
    "url": "https://github.com/homalozoa/bothub/issues"
  },
  "homepage": "https://github.com/homalozoa/bothub#readme",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*",
    "industry"
  ],
  "engines": {
    "node": ">=24.11"
  },
  "overrides": {
    "fflate": "0.7.5"
  },
  "scripts": {
    "build:home": "node scripts/build-home.ts",
    "doctor": "node --env-file-if-exists=.env scripts/doctor.ts",
    "demo:prepare": "node scripts/demo.ts",
    "sources:check": "node scripts/check-sources.ts",
    "test:sources": "node --test industry/evaluation/*.test.ts",
    "db:migrate": "node --env-file-if-exists=.env scripts/migrate.ts",
    "dev:api": "npm run dev -w @aihot/api",
    "dev:worker": "npm run dev -w @aihot/worker",
    "dev:web": "npm run dev -w @aihot/web",
    "typecheck": "tsc -p packages/contracts && tsc -p packages/backend && tsc -p apps/api && tsc -p apps/worker && tsc -p tests && npm run typecheck -w @aihot/web",
    "test": "node --test --test-concurrency=1 --test-timeout=120000 \"tests/*.test.ts\""
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.1.0",
    "@types/node": "26.6.3",
    "@types/sanitize-html": "2.16.1",
    "@types/turndown": "5.0.6",
    "opentype.js": "1.3.4",
    "typescript": "7.0.2"
  }
}
